# ── Delamain Environment Configuration ───────────────────────────────────────
# Copy this file to .env and fill in your values.
# The backend reads these at startup via os.environ.get().

# ── LLM Backend ───────────────────────────────────────────────────────────────
# URL to your llama.cpp / compatible OpenAI API server
# Examples: http://localhost:8080/v1/chat/completions
#           http://192.168.1.100:8080/v1/chat/completions
LLM_URL=http://localhost:8080/v1/chat/completions

# ── Web Search (optional) ─────────────────────────────────────────────────────
# SearXNG instance for real-time search (weather, traffic, etc.)
# Leave blank to disable web search
SEARXNG_URL=http://localhost:8887/search

# ── CORS / Allowed Origins ────────────────────────────────────────────────────
# Comma-separated list of origins allowed to connect to the backend.
# Include your public domain if internet-facing.
# Example: https://delamain.example.com,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# ── Port ─────────────────────────────────────────────────────────────────────
# Backend API port (default 8888)
PORT=8888
