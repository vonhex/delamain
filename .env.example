# ── Delamain Environment Configuration ───────────────────────────────────────
# Optional. Everything marked in the README can also be set in the web UI under
# Settings → Integrations, which takes precedence. To use a file instead, copy this to
# .env and fill in your values.

# ── LLM Backend ───────────────────────────────────────────────────────────────
# OpenAI-compatible chat completions endpoint with tool calling
# (llama.cpp server, vLLM, Halogen, …)
# Examples: http://localhost:8080/v1/chat/completions
#           http://192.168.1.100:8731/v1/chat/completions
LLM_URL=http://localhost:8080/v1/chat/completions

# ── Web Search (optional) ─────────────────────────────────────────────────────
# SearXNG instance for real-time search (weather, traffic, etc.) and the news fallback
SEARXNG_URL=http://localhost:8887/search
# Google News RSS base for the news tool
NEWS_RSS_URL=https://news.google.com/rss

# ── CORS / Allowed Origins ────────────────────────────────────────────────────
# Comma-separated list of origins allowed to connect to the backend.
# Include your public domain if internet-facing.
# Example: https://delamain.example.com,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# ── Port ─────────────────────────────────────────────────────────────────────
# Backend API port (default 8888)
PORT=8888

# ── Model name / reasoning ───────────────────────────────────────────────────
# Model id sent to the LLM endpoint (llama.cpp ignores it; Halogen/vLLM report theirs at /v1/models)
LLM_MODEL=gpt-4-vision-preview
# For reasoning models: "none" disables thinking so max_tokens goes to the reply. Leave blank to omit.
LLM_REASONING_EFFORT=

# ── Feature switches ──────────────────────────────────────────────────────────
# Let the LLM call tools: web search, news, Obsidian notes and long-term memory
TOOLS_ENABLED=true
# Obsidian vault for notes and memory (Delamain writes under Delamain/). Default: ~/Documents/obsidian vault
OBSIDIAN_VAULT_PATH=
