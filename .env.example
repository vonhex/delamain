# ── Delamain Environment Configuration ───────────────────────────────────────
# Copy this file to .env and fill in your values.
# The backend reads these at startup via os.environ.get().

# ── LLM Backend ───────────────────────────────────────────────────────────────
# URL to your llama.cpp / compatible OpenAI API server
# Examples: http://localhost:8080/v1/chat/completions
#           http://192.168.1.100:8080/v1/chat/completions
LLM_URL=http://localhost:8080/v1/chat/completions

# ── Web Search (optional) ─────────────────────────────────────────────────────
# SearXNG instance for real-time search (weather, traffic, etc.)
# Leave blank to disable web search
SEARXNG_URL=http://localhost:8887/search

# ── CORS / Allowed Origins ────────────────────────────────────────────────────
# Comma-separated list of origins allowed to connect to the backend.
# Include your public domain if internet-facing.
# Example: https://delamain.example.com,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# ── Port ─────────────────────────────────────────────────────────────────────
# Backend API port (default 8888)
PORT=8888

# ── Model name / reasoning ───────────────────────────────────────────────────
# Model id sent to the LLM endpoint (llama.cpp ignores it; Halogen/vLLM report theirs at /v1/models)
LLM_MODEL=gpt-4-vision-preview
# For reasoning models: "none" disables thinking so max_tokens goes to the reply. Leave blank to omit.
LLM_REASONING_EFFORT=

# ── Feature switches ──────────────────────────────────────────────────────────
# Comma / sunnypilot bridge (vehicle prompt, telemetry, road camera). false = general assistant.
COMMA_ENABLED=true
# Let the LLM call tools: web search (SEARXNG_URL), Obsidian notes and long-term memory
TOOLS_ENABLED=true
OBSIDIAN_VAULT_PATH=
